# ==============================================================================
# Projeto Integrador - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ambientes Virtuais e Caches Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ------------------------------------------------------------------------------
# 2. Node.js e Pacotes Web (caso colegas utilizem dependências locais)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json.bak

# ------------------------------------------------------------------------------
# 3. Variáveis de Ambiente, Credenciais e Segredos
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets.json

# ------------------------------------------------------------------------------
# 4. Sistemas Operacionais e Arquivos Temporários de Disco
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# Linux
*~
.directory
.fuse_hidden*
.nfs*

# ------------------------------------------------------------------------------
# 5. Editores e IDEs (VS Code, JetBrains/PyCharm, Vim)
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ------------------------------------------------------------------------------
# 6. Artefatos Temporários de Compilação de Relatórios / Pandoc / LaTeX
# ------------------------------------------------------------------------------
07_relatorio/build/*.tmp
07_relatorio/build/*.log
*.aux
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# ------------------------------------------------------------------------------
# 7. Configurações Locais de Ferramentas de IA e Design
# ------------------------------------------------------------------------------
.impeccable/config.local.json
.impeccable/live/
